# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard → Project Settings → API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: salt for hashing client addresses in contact-form rate limiting.
CONTACT_HASH_SALT=

# Scripts only (seed / create admin). Never used by the app, never expose it.
SUPABASE_SERVICE_ROLE_KEY=
